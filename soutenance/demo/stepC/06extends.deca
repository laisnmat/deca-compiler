class Sun extends CelestialBody{
    int surfaceHeat;
    int color;
        void createBody(){
            int val;
            println("Quel est le diamètre de votre Soleil");
            this.diameter = readInt();
            println("Quel est la température de surface de votre Soleil");
            this.surfaceHeat = readInt();
            println("Quel est la couleur de votre Soleil ? 1=Bleu,2=Rouge,3=Blanc");
            this.color = readInt();
        }
        void displayAttributes(){
            println("This Sun has a diameter of ",this.diameter);
            println("This Sun has a surface heat of ",this.surfaceHeat);
            print("This Sun has a ");
            if(this.color == 1){
                println("blue color");
            }else if(this.color == 2){
                println("red color");
            }else if(this.color == 3){
                println("white color");
            }else{
                println("color unknown");
            }
        }
}


class Planet extends CelestialBody{
  int inhabitants;
  boolean isOurHome = false;
        void createBody(){
                println("Quel est le diamètre de votre Planète");
                this.diameter = readInt();
                println("Quel est le nombre de créatures vivante sur votre Planète");
                this.inhabitants = readInt();
                println("Est-ce que cette planète est notre maison ? 1=Oui");
                if (readInt() == 1) {
                    this.isOurHome = true;
                }
                else {
                    this.isOurHome = false;
                }
          }

          void displayAttributes(){
              println("This Planet has a diameter of ",this.diameter);
              println("This Planet has ",this.inhabitants, " inhabitants");
                if (this.isOurHome) {
                  println("This planet is our home");
                }
                else {
                  println("This planet isn't our home");
                }
          }
}

{
    Sun sun;
    Planet planet;
    int readV;
    println("Vous voulez créer une Planète(1) ou un Soleil(2)");

    readV = readInt();
    if(readV==2){
        sun = new Sun();
        sun.createBody();
        sun.displayAttributes();

    }
    else{
        planet = new Planet();
        planet.createBody();
        planet.displayAttributes();
    }

}