class Point2D {
    float x;
    int y;

    void diag(int a){
        this.x = this.x+a;
        this.y = this.y+a;
    }
}

class Point3D extends Point2D {
    int z;

    void diag(int a){
        this.x = this.x+a;
        this.y = this.y+a;
        this.z = this.z+a;
    }
}

{
    Point2D p1,p2;
    Point3D p3;

    p1 = new Point2D();
    p1.x = 5;
    p1.y = 2;
    println("P1: x = ", p1.x, " y = ", p1.y);
    //p1.diag(1);

    p3 = new Point3D();
    p3.z = p1.y;
    p3.y = 10;
    println("P3: z = ", p3.z, " y = ", p3.y);
    //p3.diag(2);
    p2 = p1;
    println("P2: y = ", p2.y);
    p2 = p3;
    println("P2: y = ", p2.y);
    //p2.diag(3);
}