// Description:
//    Compilation de l'expression and.
//      Même si l'expression n'est pas une condition, il faut générer du code pour 
//      gérer les éventuelles assignations dans le code.
//
// Resultats:
//      2=2
//      true
//      4=4
//      true
//      6=6
//      false
//      7=7
//      false
//
// Historique:
//    cree le 25/05/2024

{
    int x;
    boolean y;
    
    y = ((x = 2) == 2) && (3 < 4);
    println("2=", x);
    if (y == true) {
        println("true");
    } else {
        println("false");
    }

    y = ((x = 3) == 3 && (x = 4) == 4);
    println("4=", x);
    if (y == true) {
        println("true");
    } else {
        println("false");
    }

    y = ((x = 5) == 5 && (x = 6) == 0);
    println("6=", x);
    if (y == true) {
        println("true");
    } else {
        println("false");
    }

    y = ((x = 7) == 0 && (x = 8) == 8);
    println("7=", x);
    if (y == true) {
        println("true");
    } else {
        println("false");
    }
}