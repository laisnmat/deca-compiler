// Description:
//    Compilation d'un simple while.
//
// Resultats:
//      hello
//      hello
//      hello
//
// Historique:
//    cree le 25/05/2024

{
    int x = 0;
    while (x < 3) {
        println("hello");
        
        if (x == 0) {
            x = 1;
        } else {
            if (x == 1) {
                x = 2;
            } else {
                if (x == 2) {
                x = 3;
                }
            }
        }
    }
}
