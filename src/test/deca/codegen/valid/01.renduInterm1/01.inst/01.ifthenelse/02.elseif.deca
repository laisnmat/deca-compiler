{
    if (1 < 2) {
        print("hello");
    } else if (1 < 2) {
        println("BAD");
    } else {
        println("BAD");
    }

    if (2 < 1) {
        println("BAD");
    } else if (2 < 1) {
        println("BAD");
    } else {
        print(" world");
    }

    if (2 < 1) {
        println("BAD");
    } else if (1 < 2) {
        print("!");
    } else {
        println("BAD");
    }
}
